  "scripts": {
    "prepare": "vp config",
    "openapi": "openapi-ts && vp fmt -- app/api/ app/api-profiles/",
    "dev": "vp dev",
    "start": "vp dev",
    "start-beta": "APP_REGION=BETA vp dev",
    "start-dev": "APP_REGION=DEV vp dev",
    "start-www2": "APP_REGION=WWW2 vp dev",
    "lint": "vp lint --max-warnings 0",
    "test": "vp lint --max-warnings 0",
    "preview": "vp preview",
    "build": "vp build",
    "build-prod": "vp build",
    "build-beta": "APP_REGION=BETA vp build",
    "build-dev": "APP_REGION=DEV vp build",
    "build-www2": "APP_REGION=WWW2 vp build",
    "build-iframe": "vp pack",
    "tx-pull-json": "tx pull --use-git-timestamps --mode onlytranslated albina-website.website albina-website.caaml-json albina-website.internal-glossary bulletin-glossary.bulletin-glossary albina-admin-gui.incident-report",
    "changelog": "git-cliff --unreleased --prepend CHANGELOG.md --tag",
    "changelog-latest": "git-cliff --latest --prepend CHANGELOG.md"
  },
  "dependencies": {
    "@albina-euregio/linea": "^9.3.0",
