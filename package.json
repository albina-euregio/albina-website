    "htmr": "^1.0.2",
    "maplibre-gl": "^6.19.0",
    "nanostores": "^1.5.4",
    "normalize.css": "^8.0.1",
    "pmtiles": "^4.5.0",
    "purecss-sass": "3.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-string-replace": "^2.0.1",
    "react-swipeable": "^7.0.2",
    "temporal-polyfill": "^1.0.1"
